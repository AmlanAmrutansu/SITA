{
  "name": "workspace",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --config artifacts/sita-health/vite.config.ts && esbuild server.ts --bundle --platform=node --format=cjs --sourcemap --outfile=dist/server.cjs --external:express --external:cors --external:cookie-parser --external:tesseract.js --external:pino-http --external:dotenv",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@netlify/functions": "^6.0.0",
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "serverless-http": "^4.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  }
}