# ==============================================================================
# SITA Health — Environment Configuration
# Architecture: Express API Server + Supabase Auth & PostgreSQL (RLS) + Groq AI
# ==============================================================================

# 1. Groq AI API Key (Required server-side for health companion chat and screening)
GROQ_API_KEY=

# 2. Supabase Integration (Required for User Auth & Row Level Security storage)
# Note: In cloud environments with connector integration, these may be auto-injected.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 3. Server Port (defaults to 3000)
PORT=3000
